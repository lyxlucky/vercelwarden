TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token
JWT_SECRET=change-me-to-a-random-string
ADMIN_PASSWORD=change-me
# Server-side wrapping key for TOTP, destination credentials, and backup data keys.
SERVER_ENCRYPTION_KEY=change-me-to-a-random-32-byte-base64-value
BACKUP_ENCRYPTION_KEY=change-me-to-a-different-random-32-byte-base64-value
# WebAuthn relying-party configuration; RP ID defaults to DOMAIN hostname.
WEBAUTHN_RP_ID=your-domain.vercel.app
WEBAUTHN_RP_NAME=Vercelwarden
# Set to "true" to close public registration (advertised in /api/config)
DISABLE_REGISTRATION=false
# Require a valid, unused invitation for registration.
REQUIRE_INVITE=false
ENABLE_YUBIKEY=false
ENABLE_TWO_FACTOR_PASSKEY=false
ENABLE_ACCOUNT_PASSKEY=false
ENABLE_PASSKEY_DIRECT_UNLOCK=false
ENABLE_DEVICE_MANAGEMENT=false
ENABLE_AUTH_REQUESTS=false
ENABLE_DOMAIN_RULES_WRITE=true
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token
DOMAIN=https://your-domain.vercel.app
# Optional comma-separated origins for non-standard password-manager clients.
# Standard chrome-extension, moz-extension, and safari-web-extension origins are automatic.
BROWSER_EXTENSION_ORIGINS=
# Optional notification and backup controls.
# poll (default), sse, or websocket. WebSocket mode is experimental.
NOTIFICATIONS_MODE=poll
# Production WebSocket mode requires Vercel Fluid Compute and Redis-compatible Pub/Sub.
VERCEL_WEBSOCKET_ENABLED=false
NOTIFICATIONS_REDIS_URL=
# WebSocket catch-up replay window in ms (default 15000, max 300000). On subscribe,
# events published within this window are replayed to the client so a brief reconnect
# gap doesn't wait for the 45s poll. Set to 0 to disable replay.
NOTIFICATIONS_REPLAY_WINDOW_MS=15000
BACKUP_CRON_SECRET=change-me
MAINTENANCE_CRON_SECRET=change-me-to-a-different-random-secret
# Auto-sent by Vercel Cron as `Authorization: Bearer $CRON_SECRET`. Set this so
# the scheduled job in vercel.json can authenticate against /api/internal/maintenance.
CRON_SECRET=change-me-to-a-random-cron-secret
# Test commands refuse non-test databases unless this is explicitly true.
ALLOW_TEST_SEED=false
