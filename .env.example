TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token
JWT_SECRET=change-me-to-a-random-string
ADMIN_PASSWORD=change-me
# Server-side wrapping key for TOTP, destination credentials, and backup data keys.
SERVER_ENCRYPTION_KEY=change-me-to-a-random-32-byte-base64-value
BACKUP_ENCRYPTION_KEY=change-me-to-a-different-random-32-byte-base64-value
# WebAuthn relying-party configuration; RP ID defaults to DOMAIN hostname.
WEBAUTHN_RP_ID=your-domain.vercel.app
WEBAUTHN_RP_NAME=Vercelwarden
# Set to "true" to close public registration (advertised in /api/config)
DISABLE_REGISTRATION=false
# Require a valid, unused invitation for registration.
REQUIRE_INVITE=false
ENABLE_YUBIKEY=false
ENABLE_TWO_FACTOR_PASSKEY=false
ENABLE_ACCOUNT_PASSKEY=false
ENABLE_PASSKEY_DIRECT_UNLOCK=false
ENABLE_DEVICE_MANAGEMENT=false
ENABLE_AUTH_REQUESTS=false
ENABLE_DOMAIN_RULES_WRITE=false
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token
DOMAIN=https://your-domain.vercel.app
# Optional notification and backup controls.
NOTIFICATIONS_MODE=poll
BACKUP_CRON_SECRET=change-me
MAINTENANCE_CRON_SECRET=change-me-to-a-different-random-secret
# Test commands refuse non-test databases unless this is explicitly true.
ALLOW_TEST_SEED=false
